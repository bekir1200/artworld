{
  "buildCommand": "npm run db:migrate && npm run build",
  "functions": {
    "api/index.js": {
      "includeFiles": "public/**"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index?path=$1" }
  ],
  "crons": [
    { "path": "/api/cron/run", "schedule": "0 3 * * *" }
  ]
}
